// Main window.
//
// Layout (each row has exactly one job):
//   menu bar
//   scan toolbar          – what is scanned
//   tree | view tabs      – what is shown (+ search box)
//        | context bar    – where am I (breadcrumb) + actions on the selection
//        | filter bar     – only while searching
//        | table / panel
//        | treemap
//   status bar            – messages | totals of the current view | scan info | rights

import { Button, ComboBox, LineEdit, Palette, ProgressIndicator } from "std-widgets.slint";
import { Theme, NavKey, TabButton, Crumb, CrumbButton } from "widgets.slint";
import { DirTree, TreeRow } from "tree.slint";
import { EntryTable, EntryRow } from "table.slint";
import { TreemapView, TreemapLabel, LegendItem } from "treemap.slint";
import { CleanupView, CleanupRow } from "cleanup.slint";

export { TreeRow, EntryRow, NavKey, TreemapLabel, LegendItem, CleanupRow, Crumb }

// View tabs (must match `View::tab()` in app.rs).
export global Tabs {
    out property <int> folder: 0;
    out property <int> largest: 1;
    out property <int> search: 2;
    out property <int> duplicates: 3;
    out property <int> cleanup: 4;
}

export component MainWindow inherits Window {
    title: "SpaceLens";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 540px;
    background: Palette.background;

    // --- scan controls ---
    in property <[string]> drives;
    in-out property <int> drive-index: -1;
    in-out property <string> scan-path;
    in property <bool> scanning;
    in property <bool> elevated;

    // --- scan progress (shown while `scanning`) ---
    in property <string> progress-counts;
    in property <string> progress-path;

    // --- views ---
    in property <bool> has-tree;
    /// Active tab (see `Tabs`).
    in property <int> tab: 0;
    /// The cleanup overview replaces the table (its location lists use the table).
    in property <bool> cleanup-panel;

    // --- navigation / context ---
    in property <[Crumb]> crumbs;
    /// Text before the breadcrumb, e.g. "Suche in".
    in property <string> crumb-prefix;
    in property <bool> can-go-up;
    /// Totals of the current view, shown in the status bar.
    in property <string> location-info;

    // --- table ---
    in property <[TreeRow]> tree-rows;
    in property <int> tree-selected: -1;
    in property <[EntryRow]> entries;
    in property <int> entry-selected: -1;
    in property <int> sort-column: 1;
    in property <bool> sort-descending: true;
    in property <bool> deleting;

    // --- search ---
    in-out property <string> search-text;
    in property <string> search-summary;
    in-out property <int> filter-type: 0;
    in-out property <int> filter-size: 0;
    in-out property <int> filter-age: 0;

    // --- duplicates ---
    in-out property <int> dupes-min: 1;
    in property <bool> dupes-running;
    in property <bool> dupes-has-results;
    in property <string> dupes-summary;

    // --- cleanup ---
    in property <[CleanupRow]> cleanup-rows;
    in property <string> bin-text;
    in property <bool> bin-empty: true;
    in property <string> cleanup-hint;

    // --- treemap ---
    in-out property <bool> treemap-visible: true;
    in property <image> treemap-image;
    in property <[TreemapLabel]> treemap-labels;
    in property <[LegendItem]> treemap-legend;
    in property <bool> treemap-hover-visible;
    in property <length> treemap-hover-x;
    in property <length> treemap-hover-y;
    in property <length> treemap-hover-width;
    in property <length> treemap-hover-height;

    // --- status bar ---
    in property <string> status;
    in property <string> scan-info;

    out property <int> tree-page-rows: tree.page-rows;
    out property <int> table-page-rows: table.page-rows;

    callback drive-selected(index: int);
    callback start-scan();
    callback cancel-scan();
    callback elevate();
    callback refresh-drives();
    callback go-up();
    callback crumb-clicked(id: int);
    callback reveal-current();
    callback tree-toggle(row: int);
    callback tree-select(row: int);
    callback tree-navigate(key: NavKey);
    callback entry-click(row: int, ctrl: bool, shift: bool);
    callback entry-select-all();
    callback entry-open(row: int);
    callback entry-reveal(row: int);
    callback entry-delete(row: int);
    callback delete-selected();
    callback show-folder-view();
    callback show-largest();
    callback show-cleanup();
    callback show-duplicates();
    callback dupes-start();
    callback dupes-cancel();
    callback dupes-select-copies();
    callback search-changed(text: string);
    callback filters-changed();
    callback end-search();
    callback cleanup-show(index: int);
    callback cleanup-clean(index: int);
    callback empty-bin();
    callback entry-navigate(key: NavKey, shift: bool);
    callback sort-by(column: int);
    callback treemap-resized(width: length, height: length);
    callback treemap-hovered(x: length, y: length);
    callback treemap-left();
    callback treemap-clicked(x: length, y: length);
    callback treemap-double-clicked(x: length, y: length);
    callback show-about();
    callback quit();

    public function focus-table() {
        table.focus-list();
    }

    public function focus-search() {
        search-box.focus();
        search-box.select-all();
    }

    function start-search() {
        root.focus-search();
        root.search-changed(root.search-text);
    }

    // User-chosen sizes (splitters). The layout shrinks the panes towards
    // their minimum sizes when the window gets smaller.
    property <length> tree-width: 320px;
    property <length> treemap-height: 280px;

    MenuBar {
        Menu {
            title: "Datei";
            MenuItem {
                title: "Scannen";
                shortcut: @keys(F5);
                activated => { root.start-scan(); }
            }
            MenuItem {
                title: "Scan abbrechen";
                enabled: root.scanning;
                activated => { root.cancel-scan(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Laufwerksliste aktualisieren";
                activated => { root.refresh-drives(); }
            }
            MenuItem {
                title: "Als Administrator neu starten";
                enabled: !root.elevated;
                activated => { root.elevate(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Beenden";
                activated => { root.quit(); }
            }
        }
        Menu {
            title: "Bearbeiten";
            MenuItem {
                title: "In den Papierkorb verschieben …  (Entf)";
                enabled: root.has-tree && root.entry-selected >= 0 && !root.deleting;
                activated => { root.delete-selected(); }
            }
            MenuItem {
                title: "Im Explorer anzeigen";
                enabled: root.has-tree;
                activated => { root.reveal-current(); }
            }
        }
        Menu {
            title: "Ansicht";
            MenuItem {
                title: "Ordnerinhalt";
                enabled: root.has-tree;
                activated => { root.show-folder-view(); }
            }
            MenuItem {
                title: "Größte Dateien";
                enabled: root.has-tree;
                activated => { root.show-largest(); }
            }
            MenuItem {
                title: "Suchen …";
                shortcut: @keys(Control + F);
                enabled: root.has-tree;
                activated => { root.start-search(); }
            }
            MenuItem {
                title: "Duplikate";
                enabled: root.has-tree;
                activated => { root.show-duplicates(); }
            }
            MenuItem {
                title: "Aufräumen";
                enabled: root.has-tree;
                activated => { root.show-cleanup(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Übergeordneter Ordner";
                enabled: root.can-go-up;
                activated => { root.go-up(); }
            }
            MenuItem {
                title: root.treemap-visible ? "Treemap ausblenden" : "Treemap einblenden";
                activated => { root.treemap-visible = !root.treemap-visible; }
            }
        }
        Menu {
            title: "Hilfe";
            MenuItem {
                title: "Über SpaceLens";
                activated => { root.show-about(); }
            }
        }
    }

    VerticalLayout {
        // ------------------------------------------------ scan toolbar
        Rectangle {
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;

                ComboBox {
                    // Shares the row with the path field; shrinks on narrow windows.
                    min-width: 200px;
                    preferred-width: 360px;
                    max-width: 360px;
                    horizontal-stretch: 0.4;
                    model: root.drives;
                    current-index <=> root.drive-index;
                    enabled: !root.scanning;
                    selected => { root.drive-selected(self.current-index); }
                }

                LineEdit {
                    horizontal-stretch: 1;
                    min-width: 120px;
                    text <=> root.scan-path;
                    placeholder-text: "Pfad, z. B. C:\\ oder D:\\Daten";
                    enabled: !root.scanning;
                    accepted => { root.start-scan(); }
                }

                Button {
                    width: 110px;
                    text: root.scanning ? "Abbrechen" : "Scannen";
                    primary: !root.scanning;
                    clicked => {
                        if root.scanning {
                            root.cancel-scan();
                        } else {
                            root.start-scan();
                        }
                    }
                }

                if !root.elevated: Button {
                    text: "Als Administrator neu starten";
                    enabled: !root.scanning;
                    clicked => { root.elevate(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        // ------------------------------------------------ content
        Rectangle {
            vertical-stretch: 1;

            HorizontalLayout {
                // Stretch > 0 so the layout may shrink it (a stretch of 0
                // never shrinks); max-width caps it at the user's width.
                tree := DirTree {
                    min-width: 190px;
                    preferred-width: root.tree-width;
                    max-width: root.tree-width;
                    horizontal-stretch: 1;
                    rows: root.tree-rows;
                    selected: root.tree-selected;
                    toggle(row) => { root.tree-toggle(row); }
                    select(row) => { root.tree-select(row); }
                    navigate(key) => { root.tree-navigate(key); }
                }

                // Splitter tree | right pane.
                Rectangle {
                    width: 5px;
                    background: vsplit.has-hover || vsplit.pressed ? Theme.bar-fill.with-alpha(0.4) : Theme.divider;
                    vsplit := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            root.tree-width = clamp(tree.width + self.mouse-x - self.pressed-x, 190px, root.width * 0.5);
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;

                    // View tabs + search.
                    Rectangle {
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 8px;
                            spacing: 0px;

                            TabButton {
                                text: "Ordnerinhalt";
                                active: root.tab == Tabs.folder;
                                enabled: root.has-tree;
                                clicked => { root.show-folder-view(); }
                            }
                            TabButton {
                                text: "Größte Dateien";
                                active: root.tab == Tabs.largest;
                                enabled: root.has-tree;
                                clicked => { root.show-largest(); }
                            }
                            TabButton {
                                text: "Suche";
                                active: root.tab == Tabs.search;
                                enabled: root.has-tree;
                                clicked => { root.start-search(); }
                            }
                            TabButton {
                                text: "Duplikate";
                                active: root.tab == Tabs.duplicates;
                                enabled: root.has-tree;
                                clicked => { root.show-duplicates(); }
                            }
                            TabButton {
                                text: "Aufräumen";
                                active: root.tab == Tabs.cleanup;
                                enabled: root.has-tree;
                                clicked => { root.show-cleanup(); }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 8px;
                            }

                            VerticalLayout {
                                alignment: center;
                                search-box := LineEdit {
                                    min-width: 150px;
                                    preferred-width: 280px;
                                    max-width: 340px;
                                    placeholder-text: "Suchen … (Strg+F)";
                                    text <=> root.search-text;
                                    enabled: root.has-tree;
                                    edited(text) => { root.search-changed(text); }
                                    accepted(text) => { root.search-changed(text); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    // Context bar: breadcrumb + actions on the selection.
                    Rectangle {
                        HorizontalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;
                            padding-left: 6px;
                            padding-right: 8px;
                            spacing: 6px;

                            Button {
                                text: "↑";
                                width: 34px;
                                enabled: root.can-go-up;
                                clicked => { root.go-up(); }
                            }

                            if root.crumb-prefix != "": Text {
                                text: root.crumb-prefix;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }

                            // Breadcrumb: may shrink to nothing; segments elide.
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                clip: true;
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 0px;
                                    for crumb[i] in root.crumbs: HorizontalLayout {
                                        spacing: 0px;
                                        if i > 0: Text {
                                            text: "›";
                                            color: Theme.muted;
                                            vertical-alignment: center;
                                            width: 12px;
                                            horizontal-alignment: center;
                                        }
                                        CrumbButton {
                                            text: crumb.text;
                                            last: i == root.crumbs.length - 1;
                                            clicked => { root.crumb-clicked(crumb.id); }
                                        }
                                    }
                                }
                            }

                            if !root.cleanup-panel: Button {
                                text: "Im Explorer";
                                enabled: root.has-tree;
                                clicked => { root.reveal-current(); }
                            }
                            if !root.cleanup-panel: Button {
                                text: "In den Papierkorb …";
                                enabled: root.entry-selected >= 0 && !root.deleting && !root.scanning;
                                clicked => { root.delete-selected(); }
                            }
                        }
                    }

                    // Filters, only while searching.
                    if root.tab == Tabs.search: Rectangle {
                        background: Palette.alternate-background;
                        HorizontalLayout {
                            padding: 6px;
                            padding-left: 8px;
                            spacing: 8px;
                            ComboBox {
                                width: 170px;
                                model: ["Alle Typen", "Videos", "Musik & Audio", "Bilder", "Archive", "Disk-Images & VMs", "Programme", "Dokumente", "Code & Daten", "System", "Sonstiges", "Nur Ordner"];
                                current-index <=> root.filter-type;
                                selected => { root.filters-changed(); }
                            }
                            ComboBox {
                                width: 160px;
                                model: ["Jede Größe", "größer als 1 MB", "größer als 10 MB", "größer als 100 MB", "größer als 1 GB", "größer als 10 GB"];
                                current-index <=> root.filter-size;
                                selected => { root.filters-changed(); }
                            }
                            ComboBox {
                                width: 170px;
                                model: ["Jedes Alter", "älter als 30 Tage", "älter als 6 Monate", "älter als 1 Jahr", "älter als 2 Jahre", "älter als 5 Jahre"];
                                current-index <=> root.filter-age;
                                selected => { root.filters-changed(); }
                            }
                            Text {
                                text: root.search-summary;
                                color: Theme.muted;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                overflow: elide;
                            }
                            Button {
                                text: "Suche beenden";
                                clicked => { root.end-search(); }
                            }
                        }
                    }

                    // Duplicate finder controls, only on the duplicates tab.
                    if root.tab == Tabs.duplicates: Rectangle {
                        background: Palette.alternate-background;
                        HorizontalLayout {
                            padding: 6px;
                            padding-left: 8px;
                            spacing: 8px;
                            ComboBox {
                                width: 140px;
                                model: ["ab 100 KB", "ab 1 MB", "ab 10 MB", "ab 100 MB"];
                                current-index <=> root.dupes-min;
                                enabled: !root.dupes-running;
                            }
                            Button {
                                text: root.dupes-running ? "Abbrechen" : "Duplikate suchen";
                                primary: !root.dupes-running && !root.dupes-has-results;
                                enabled: !root.deleting && !root.scanning;
                                clicked => {
                                    if root.dupes-running {
                                        root.dupes-cancel();
                                    } else {
                                        root.dupes-start();
                                    }
                                }
                            }
                            if root.dupes-running: VerticalLayout {
                                alignment: center;
                                ProgressIndicator {
                                    width: 80px;
                                    height: 4px;
                                    indeterminate: true;
                                }
                            }
                            Text {
                                text: root.dupes-summary;
                                color: Theme.muted;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                overflow: elide;
                            }
                            Button {
                                text: "Kopien auswählen";
                                enabled: root.dupes-has-results && !root.dupes-running;
                                clicked => { root.dupes-select-copies(); }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    // Table and cleanup panel share this area; the table stays
                    // instantiated so its state (scroll, focus) survives.
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 170px;

                        table := EntryTable {
                            width: parent.width;
                            height: parent.height;
                            visible: !root.cleanup-panel;
                            rows: root.entries;
                            selected: root.entry-selected;
                            sort-column: root.sort-column;
                            sort-descending: root.sort-descending;
                            click(row, ctrl, shift) => { root.entry-click(row, ctrl, shift); }
                            select-all => { root.entry-select-all(); }
                            open(row) => { root.entry-open(row); }
                            reveal(row) => { root.entry-reveal(row); }
                            delete(row) => { root.entry-delete(row); }
                            sort(column) => { root.sort-by(column); }
                            navigate(key, shift) => { root.entry-navigate(key, shift); }
                        }

                        if root.cleanup-panel: CleanupView {
                            width: parent.width;
                            height: parent.height;
                            rows: root.cleanup-rows;
                            bin-text: root.bin-text;
                            bin-empty: root.bin-empty;
                            busy: root.deleting || root.scanning;
                            hint: root.cleanup-hint;
                            show(i) => { root.cleanup-show(i); }
                            clean(i) => { root.cleanup-clean(i); }
                            empty-bin => { root.empty-bin(); }
                        }
                    }

                    // Splitter table | treemap.
                    if root.treemap-visible: Rectangle {
                        height: 5px;
                        background: hsplit.has-hover || hsplit.pressed ? Theme.bar-fill.with-alpha(0.4) : Theme.divider;
                        hsplit := TouchArea {
                            mouse-cursor: row-resize;
                            moved => {
                                root.treemap-height = clamp(root.treemap-height - (self.mouse-y - self.pressed-y), 100px, root.height * 0.6);
                            }
                        }
                    }

                    if root.treemap-visible: TreemapView {
                        // Gives way to the table (min 120px) on short windows.
                        min-height: 90px;
                        preferred-height: root.treemap-height;
                        max-height: root.treemap-height;
                        vertical-stretch: 1;
                        image: root.treemap-image;
                        labels: root.treemap-labels;
                        legend: root.treemap-legend;
                        hover-visible: root.treemap-hover-visible;
                        hover-x: root.treemap-hover-x;
                        hover-y: root.treemap-hover-y;
                        hover-width: root.treemap-hover-width;
                        hover-height: root.treemap-hover-height;
                        resized(w, h) => { root.treemap-resized(w, h); }
                        hovered(x, y) => { root.treemap-hovered(x, y); }
                        left => { root.treemap-left(); }
                        clicked(x, y) => { root.treemap-clicked(x, y); }
                        double-clicked(x, y) => { root.treemap-double-clicked(x, y); }
                    }
                }
            }

            // Placeholder / progress overlay; covers (and blocks) the content.
            if !root.has-tree: Rectangle {
                background: Palette.background;
                TouchArea { }
                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    padding: 24px;

                    Text {
                        text: root.scanning ? "Scanne …" : "Laufwerk oder Ordner wählen und „Scannen“ klicken";
                        font-size: 18px;
                        horizontal-alignment: center;
                    }
                    if root.scanning: Text {
                        text: root.progress-counts;
                        color: Theme.muted;
                        horizontal-alignment: center;
                    }
                    if root.scanning: Text {
                        text: root.progress-path;
                        color: Theme.muted;
                        overflow: elide;
                        horizontal-alignment: center;
                    }
                    if !root.scanning && !root.elevated: Text {
                        text: "Hinweis: Ohne Administratorrechte fehlen geschützte Ordner (z. B. andere Benutzerprofile).";
                        color: Theme.muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        // ------------------------------------------------ status bar
        Rectangle {
            height: 26px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 10px;

                if root.scanning: VerticalLayout {
                    alignment: center;
                    ProgressIndicator {
                        width: 100px;
                        height: 4px;
                        indeterminate: true;
                    }
                }
                // Messages, hover and selection details.
                Text {
                    text: root.status;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                // Totals of the current view – always visible.
                if root.location-info != "": HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 1px;
                        background: Theme.divider;
                    }
                    // The totals win over the message: they only elide beyond 520px.
                    Text {
                        text: root.location-info;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: min(self.preferred-width, 520px);
                        max-width: 520px;
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.divider;
                }
                Text {
                    text: root.scan-info;
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 40px;
                    max-width: 300px;
                }
                Text {
                    text: root.elevated ? "Admin" : "Standard";
                    color: root.elevated ? Palette.accent-background : Theme.muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}
